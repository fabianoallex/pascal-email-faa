<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="pascal_email_faa_smtp"/>
    <Author Value="Fabiano Arndt"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <IncludeFiles Value="..\src"/>
        <OtherUnitFiles Value="..\adapters\smtp"/>
        <UnitOutputDirectory Value="lib-smtp\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="pascal-email-faa's SMTP sender: STARTTLS or implicit TLS through pascal-common-faa's PascalCommon.Transport (SChannel or OpenSSL, verified), AUTH PLAIN/LOGIN/XOAUTH2, partial recipient refusal, errors classified for retries."/>
    <License Value="MIT"/>
    <Version Minor="1"/>
    <Files>
      <Item>
        <Filename Value="..\adapters\smtp\PascalEmail.Smtp.pas"/>
        <UnitName Value="PascalEmail.Smtp"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="pascal_email_faa"/>
        <MinVersion Minor="1" Valid="True"/>
      </Item>
      <Item>
        <PackageName Value="pascal_common_faa"/>
        <MinVersion Major="1" Minor="32" Valid="True"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
